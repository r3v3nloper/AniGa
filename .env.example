PORT=3000
JWT_SECRET=your-super-secret-key-change-this

# Anzahl vertrauenswürdiger Proxy-Hops vor der App (nginx, Traefik, Synology-Reverse-Proxy).
# NUR setzen, wenn wirklich ein Proxy davorsteht — sonst kann sich jeder Client per
# X-Forwarded-For eine beliebige IP geben und das Login-Rate-Limit umgehen.
# Leer lassen bei direktem Port-Zugriff.
TRUST_PROXY=

# TMDB (Filme & Serien) — https://www.themoviedb.org/settings/api
# Akzeptiert den v4 "API-Lesezugriffstoken" (eyJ…) ODER den v3 "API-Schlüssel"
TMDB_API_TOKEN=

# IGDB (Spiele) — kostenlose Twitch-Developer-App auf https://dev.twitch.tv/console/apps
# „Register Your Application" → OAuth Redirect URL: http://localhost
# Daraus Client-ID und Client-Secret übernehmen; das OAuth-Token holt der Server selbst.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Admin-Seed (nur beim ersten Start relevant)
ADMIN_EMAIL=admin@aniga.local
ADMIN_PASSWORD=change-this-password

# Für Docker auf Synology:
# Dein GitHub-Username/Repo (z.B. azurech/aniga)
GITHUB_REPO=dein-github-user/aniga
