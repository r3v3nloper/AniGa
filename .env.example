PORT=3000
JWT_SECRET=your-super-secret-key-change-this

# TMDB (Filme & Serien) — https://www.themoviedb.org/settings/api
# Akzeptiert den v4 "API-Lesezugriffstoken" (eyJ…) ODER den v3 "API-Schlüssel"
TMDB_API_TOKEN=

# Admin-Seed (nur beim ersten Start relevant)
ADMIN_EMAIL=admin@aniga.local
ADMIN_PASSWORD=change-this-password

# Für Docker auf Synology:
# Dein GitHub-Username/Repo (z.B. azurech/aniga)
GITHUB_REPO=dein-github-user/aniga
